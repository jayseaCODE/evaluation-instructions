{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CompanyApi",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/CompanyApi/bin/Debug/net10.0/CompanyApi.dll",
      "cwd": "${workspaceFolder}/src/CompanyApi",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5143"
      }
    }
  ]
}
